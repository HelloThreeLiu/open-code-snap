{
  "name": "open-code-snap",
  "displayName": "Open Code Snap",
  "description": "📷 Open-source code screenshot tool — select code, get a beautiful image. 高亮跟随编辑器主题，Canvas 自绘导出，不污染剪贴板。",
  "version": "0.3.0",
  "publisher": "open-code-snap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelloThreeLiu/open-code-snap"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "screenshot",
    "snippet",
    "carbon",
    "polacode",
    "codesnap"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openCodeSnap.start",
        "title": "Open Code Snap",
        "icon": "$(camera)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "openCodeSnap.start",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "openCodeSnap.start",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Open Code Snap",
      "properties": {
        "openCodeSnap.theme": {
          "type": "string",
          "default": "",
          "markdownDescription": "Shiki 主题 id。留空则跟随当前 VS Code 主题（自动映射）。"
        },
        "openCodeSnap.windowStyle": {
          "type": "string",
          "enum": [
            "macos",
            "windows",
            "none"
          ],
          "default": "macos",
          "description": "窗口样式：macOS 交通灯 / Windows 按钮 / 无"
        },
        "openCodeSnap.showWindowTitle": {
          "type": "boolean",
          "default": true,
          "description": "显示窗口标题（文件名）"
        },
        "openCodeSnap.lineNumbers": {
          "type": "string",
          "enum": [
            "off",
            "relative",
            "real"
          ],
          "default": "relative",
          "markdownDescription": "行号模式：`off` 关闭 / `relative` 从选区头计 1 / `real` 真实文档行号（按选区起始行）。旧配置 `showLineNumbers` / `realLineNumbers` 自动迁移"
        },
        "openCodeSnap.languageOverride": {
          "type": "string",
          "default": "",
          "markdownDescription": "强制指定 Shiki 语言 id（如 `python`）。留空自动跟随文档语言"
        },
        "openCodeSnap.maskStyle": {
          "type": "string",
          "enum": [
            "block",
            "asterisk"
          ],
          "default": "block",
          "markdownDescription": "脱敏遮罩样式（F10）：`block` 色块 / `asterisk` 等宽星号（按原文本宽度对齐）。遮罩在预览中选中文字后点「打码」生成，点击遮罩可恢复"
        },
        "openCodeSnap.backgroundColor": {
          "type": "string",
          "default": "#abb8c3",
          "description": "背景颜色"
        },
        "openCodeSnap.transparentBackground": {
          "type": "boolean",
          "default": false,
          "description": "透明背景（优先于一切背景样式）"
        },
        "openCodeSnap.backgroundType": {
          "type": "string",
          "enum": [
            "solid",
            "gradient",
            "grid",
            "dots"
          ],
          "default": "solid",
          "markdownDescription": "背景类型：`solid` 纯色（默认）/ `gradient` 双色渐变 / `grid` 网格 / `dots` 点阵。网格与点阵以背景颜色为底色"
        },
        "openCodeSnap.gradientColorA": {
          "type": "string",
          "default": "#7093FF",
          "description": "渐变起始色（backgroundType = gradient 时生效）"
        },
        "openCodeSnap.gradientColorB": {
          "type": "string",
          "default": "#B379F5",
          "description": "渐变结束色（backgroundType = gradient 时生效）"
        },
        "openCodeSnap.gradientAngle": {
          "type": "number",
          "default": 135,
          "description": "渐变角度（度，CSS 语义：0 向上、90 向右，范围 0-360）"
        },
        "openCodeSnap.watermarkText": {
          "type": "string",
          "default": "",
          "markdownDescription": "水印文字，留空不显示。支持模板变量 `{date}`（本地日期）与 `{file}`（窗口标题）"
        },
        "openCodeSnap.watermarkPosition": {
          "type": "string",
          "enum": [
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right",
            "tile"
          ],
          "default": "bottom-right",
          "description": "水印位置：四角或平铺"
        },
        "openCodeSnap.watermarkFontSize": {
          "type": "number",
          "default": 14,
          "description": "水印字号（px，范围 8-72）"
        },
        "openCodeSnap.watermarkOpacity": {
          "type": "number",
          "default": 0.5,
          "description": "水印透明度（0.05-1）"
        },
        "openCodeSnap.padding": {
          "type": "number",
          "default": 32,
          "description": "内边距（px）"
        },
        "openCodeSnap.borderRadius": {
          "type": "number",
          "default": 8,
          "description": "窗口圆角（px）"
        },
        "openCodeSnap.shadowColor": {
          "type": "string",
          "default": "rgba(0, 0, 0, 0.55)",
          "description": "阴影颜色"
        },
        "openCodeSnap.shadowBlur": {
          "type": "number",
          "default": 68,
          "description": "阴影模糊半径（px）"
        },
        "openCodeSnap.shadowOffsetX": {
          "type": "number",
          "default": 0,
          "description": "阴影水平偏移（px）"
        },
        "openCodeSnap.shadowOffsetY": {
          "type": "number",
          "default": 20,
          "description": "阴影垂直偏移（px）"
        },
        "openCodeSnap.fontFamily": {
          "type": "string",
          "default": "",
          "description": "字体。留空跟随编辑器字体（推荐，需系统已安装）"
        },
        "openCodeSnap.fontSize": {
          "type": "number",
          "default": 14,
          "description": "字号（px）"
        },
        "openCodeSnap.lineHeight": {
          "type": "number",
          "default": 1.6,
          "description": "行高（倍数）"
        },
        "openCodeSnap.ligatures": {
          "type": "boolean",
          "default": true,
          "description": "连字（跟随编辑器设置中的 fontLigatures）"
        },
        "openCodeSnap.tabSize": {
          "type": "number",
          "default": 0,
          "markdownDescription": "Tab 宽度。`0` 跟随文档的编辑器设置"
        },
        "openCodeSnap.exportScale": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ],
          "default": 2,
          "description": "导出缩放倍数"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "shiki": "^3.0.0"
  },
  "icon": "media/icon.png"
}

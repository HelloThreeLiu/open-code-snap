{
  "name": "open-code-snap",
  "displayName": "Open Code Snap",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "open-code-snap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HelloThreeLiu/open-code-snap"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "screenshot",
    "snippet",
    "carbon",
    "polacode",
    "codesnap"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openCodeSnap.start",
        "title": "Open Code Snap",
        "icon": "$(camera)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "openCodeSnap.start",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "openCodeSnap.start",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Open Code Snap",
      "properties": {
        "openCodeSnap.theme": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.theme%"
        },
        "openCodeSnap.windowStyle": {
          "type": "string",
          "enum": [
            "macos",
            "windows",
            "none"
          ],
          "default": "macos",
          "markdownDescription": "%config.windowStyle%"
        },
        "openCodeSnap.showWindowTitle": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showWindowTitle%"
        },
        "openCodeSnap.lineNumbers": {
          "type": "string",
          "enum": [
            "off",
            "relative",
            "real"
          ],
          "default": "relative",
          "markdownDescription": "%config.lineNumbers%"
        },
        "openCodeSnap.languageOverride": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.languageOverride%"
        },
        "openCodeSnap.maskStyle": {
          "type": "string",
          "enum": [
            "block",
            "asterisk"
          ],
          "default": "block",
          "markdownDescription": "%config.maskStyle%"
        },
        "openCodeSnap.backgroundColor": {
          "type": "string",
          "default": "#abb8c3",
          "markdownDescription": "%config.backgroundColor%"
        },
        "openCodeSnap.transparentBackground": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.transparentBackground%"
        },
        "openCodeSnap.backgroundType": {
          "type": "string",
          "enum": [
            "solid",
            "gradient",
            "grid",
            "dots"
          ],
          "default": "solid",
          "markdownDescription": "%config.backgroundType%"
        },
        "openCodeSnap.gradientColorA": {
          "type": "string",
          "default": "#7093FF",
          "markdownDescription": "%config.gradientColorA%"
        },
        "openCodeSnap.gradientColorB": {
          "type": "string",
          "default": "#B379F5",
          "markdownDescription": "%config.gradientColorB%"
        },
        "openCodeSnap.gradientAngle": {
          "type": "number",
          "default": 135,
          "markdownDescription": "%config.gradientAngle%"
        },
        "openCodeSnap.watermarkText": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.watermarkText%"
        },
        "openCodeSnap.watermarkPosition": {
          "type": "string",
          "enum": [
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right",
            "tile"
          ],
          "default": "bottom-right",
          "markdownDescription": "%config.watermarkPosition%"
        },
        "openCodeSnap.watermarkFontSize": {
          "type": "number",
          "default": 14,
          "markdownDescription": "%config.watermarkFontSize%"
        },
        "openCodeSnap.watermarkOpacity": {
          "type": "number",
          "default": 0.5,
          "markdownDescription": "%config.watermarkOpacity%"
        },
        "openCodeSnap.padding": {
          "type": "number",
          "default": 32,
          "markdownDescription": "%config.padding%"
        },
        "openCodeSnap.borderRadius": {
          "type": "number",
          "default": 8,
          "markdownDescription": "%config.borderRadius%"
        },
        "openCodeSnap.shadowColor": {
          "type": "string",
          "default": "rgba(0, 0, 0, 0.55)",
          "markdownDescription": "%config.shadowColor%"
        },
        "openCodeSnap.shadowBlur": {
          "type": "number",
          "default": 68,
          "markdownDescription": "%config.shadowBlur%"
        },
        "openCodeSnap.shadowOffsetX": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%config.shadowOffsetX%"
        },
        "openCodeSnap.shadowOffsetY": {
          "type": "number",
          "default": 20,
          "markdownDescription": "%config.shadowOffsetY%"
        },
        "openCodeSnap.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.fontFamily%"
        },
        "openCodeSnap.fontSize": {
          "type": "number",
          "default": 14,
          "markdownDescription": "%config.fontSize%"
        },
        "openCodeSnap.lineHeight": {
          "type": "number",
          "default": 1.6,
          "markdownDescription": "%config.lineHeight%"
        },
        "openCodeSnap.ligatures": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.ligatures%"
        },
        "openCodeSnap.tabSize": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%config.tabSize%"
        },
        "openCodeSnap.exportScale": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ],
          "default": 2,
          "markdownDescription": "%config.exportScale%"
        },
        "openCodeSnap.uiLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "markdownDescription": "%config.uiLanguage%",
          "order": 0
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "shiki": "^3.0.0"
  },
  "icon": "media/icon.png"
}
